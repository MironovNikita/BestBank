<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="accounts" author="MironovNikita">
        <preConditions onFail="WARN">
            <not>
                <tableExists tableName="transfers"/>
            </not>
        </preConditions>

        <createTable tableName="transfers">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id_from" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="account_id_to" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="currency_from" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_from" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_to" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_to" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="transfers"/>
        </rollback>
    </changeSet>
</databaseChangeLog>